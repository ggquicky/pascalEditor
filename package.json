{
  "name": "@pascal/editor",
  "version": "1.0.0",
  "description": "Unified 3D building editor library",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "dev:playground": "vite --config apps/playground/vite.config.ts",
    "build:playground": "tsc --project apps/playground/tsconfig.json && vite build --config apps/playground/vite.config.ts",
    "preview:playground": "vite preview --config apps/playground/vite.config.ts",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check",
    "check:fix": "biome check --write"
  },
  "peerDependencies": {
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "three": "^0.182"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dedent": "^1.7.1",
    "howler": "^2.2.4",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.14.0",
    "mitt": "^3.0.1",
    "motion": "^12.38.0",
    "nanoid": "^5.1.6",
    "tailwind-merge": "^3.5.0",
    "three-bvh-csg": "^0.0.17",
    "three-mesh-bvh": "^0.9.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.5",
    "zundo": "^2.3.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.4",
    "three": "^0.182.0",
    "typescript": "5.9.2",
    "ultracite": "^7.1.1",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.3"
}
